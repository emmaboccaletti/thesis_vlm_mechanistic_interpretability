#!/bin/bash
# Clean behavioral baseline for Qwen3 on MOMENTS goal/no-goal.
# This version activates the language-only loader path while keeping the same
# MOMENTS CSV, so you can compare the text-only path against the standard path.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen3_MOMENTS_behavior_Lonly
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/qwen3_moments_goal_behavior_language_only_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/qwen3_moments_goal_behavior_language_only_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=64G
#SBATCH --time=01:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1

source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

echo "=== Qwen3 MOMENTS goal clean behavioral evaluation (language-only loader) ==="
echo "=== Primary metric: constrained yes/no accuracy ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
nvidia-smi || true

python evaluate_moments_behavior.py \
  --model_name qwen3-vl-8b-instruct \
  --model_path /home/eboccaletti/models/Qwen3-VL-8B-Instruct \
  --csv data/moments_goal/both_data.csv \
  --language_only \
  --output_csv data/moments_goal/results/qwen3-vl-8b-instruct/behavior_clean_both_language_only.csv

# Optional stricter variant: add this flag to the command above if desired.
#   --check_counterfactual_alignment

echo "End time: $(date)"
