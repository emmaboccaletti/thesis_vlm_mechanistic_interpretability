#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_BackpatchingExp_color_ordering_OOM_fix
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/qwen_backpatching_exp_gpu_h100_color_ordering_oom_fix_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/qwen_backpatching_exp_gpu_h100_color_ordering_oom_fix_%j.err
#SBATCH --cpus-per-task=16
#SBATCH --mem=360G
#SBATCH --time=24:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1

# Activate your environment
source activate vlm_qwen_reproducing_env

set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

echo "=== Qwen Backpatching Experiment (OOM fix): color ordering job ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
echo "Working dir: $(pwd)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

nvidia-smi || true

python attempt_fix_OOM_script_backpatching_experiment.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name color_ordering \
  --src_layer_range 13 26 \
  --dst_layer_range 0 16

echo "End time: $(date)"

# OOM fix: cached_activations is now stored on CPU RAM instead of GPU.
# --mem doubled to 360G (from 180G) to give headroom for the activation cache on CPU.
# Paper best setting for Qwen2-7B-VL / color_ordering: 18 -> 15 (window size 3)
