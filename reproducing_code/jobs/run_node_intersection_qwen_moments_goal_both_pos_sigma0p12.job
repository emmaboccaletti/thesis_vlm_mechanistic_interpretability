#!/bin/bash
# MOMENTS goal intersection analysis for the regenerated POS-aware sigma0p12 dataset.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Bmom_pos_int
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/qwen_node_intersection_gpu_h100_Bmoments_goal_both_POS_sigma0p12_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/qwen_node_intersection_gpu_h100_Bmoments_goal_both_POS_sigma0p12_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=80G
#SBATCH --time=03:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

RESULT_ROOT="data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p12_nap_ig=5"
RESULT_FILE="${RESULT_ROOT}/intersection/faithfulness_nodes_intersection_LD_${SLURM_JOB_ID}.pt"

mkdir -p "$(dirname "${RESULT_FILE}")"

echo "=== Qwen2 MOMENTS goal intersection ==="
echo "=== Counterfactual mode: both; POS-aware sigma0p12 dataset ==="
echo "=== Circuit percentages: L=1%, VL=3% ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
nvidia-smi || true

python script_node_intersection.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode both \
  --scores_dir "${RESULT_ROOT}" \
  --output_file "${RESULT_FILE}" \
  --l_circuit_percentage 0.01 \
  --vl_circuit_percentage 0.03

echo "Saved mode-specific result: ${RESULT_FILE}"
echo "End time: $(date)"
