#!/bin/bash
# MOMENTS goal circuit discovery / eval for the regenerated POS-aware sigma0p12 dataset.
# This writes the base node-score directory that downstream intersection and
# backpatching jobs will read.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Bmom_pos_ig5
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/qwen_node_circuit_gpu_h100_Bmoments_goal_both_POS_sigma0p12_ig5_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/qwen_node_circuit_gpu_h100_Bmoments_goal_both_POS_sigma0p12_ig5_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=64G
#SBATCH --time=03:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1

source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

RESULT_ROOT="data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p12_nap_ig=5"

echo "=== Qwen2 MOMENTS goal circuit discovery / eval ==="
echo "=== Counterfactual mode: both ==="
echo "=== Dataset: sigma0p12 regenerated compatibility CSVs ==="
echo "=== Result root: ${RESULT_ROOT} ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
echo "Working dir: $(pwd)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

nvidia-smi || true

python script_node_circuit_discovery_and_eval.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode both \
  --ap_ig_steps 5 \
  --output_dir "${RESULT_ROOT}"

echo "End time: $(date)"
