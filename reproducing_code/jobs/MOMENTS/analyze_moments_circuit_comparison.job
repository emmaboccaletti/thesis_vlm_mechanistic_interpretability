#!/bin/bash
# Post-process saved MOMENTS circuit scores; no GPU inference is required.
#SBATCH --partition=rome
#SBATCH --job-name=MOMENTS_compare
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/moments_circuit_comparison_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/moments_circuit_comparison_%j.err
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis
python analyze_moments_circuit_comparison.py \
  --results_root data/moments_goal/results \
  --output_dir figures/moments_circuit_comparison \
  --top_k 5 10 20
