#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Vmoments_goal_intersection_vision_only_smoke_NodeIntersection_gpu_h100
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_intersection_gpu_h100_Vmoments_goal_vision_only_smoketest_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_intersection_gpu_h100_Vmoments_goal_vision_only_smoketest_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=80G
#SBATCH --time=03:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1

source activate vlm_qwen_reproducing_env

set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

RESULT_FILE="data/moments_goal/results/qwen2-7b-vl-instruct_vision_only_nap_ig=5/intersection/faithfulness_nodes_intersection_LD_${SLURM_JOB_ID}.pt"
mkdir -p "$(dirname "$RESULT_FILE")"

echo "=== Qwen node intersection: MOMENTS goal smoke test (vision_only) ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
echo "Working dir: $(pwd)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

nvidia-smi || true

python script_node_intersection.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode vision_only \
  --scores_dir data/moments_goal/results/qwen2-7b-vl-instruct_vision_only_nap_ig=5 \
  --output_file "$RESULT_FILE" \
  --l_circuit_percentage 0.01 \
  --vl_circuit_percentage 0.03

echo "End time: $(date)"
