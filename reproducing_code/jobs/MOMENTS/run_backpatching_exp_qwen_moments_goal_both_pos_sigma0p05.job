#!/bin/bash
# Qwen2 MOMENTS goal backpatching for POS-aware sigma0p05.
# Requires completed sigma0p05 circuit-discovery outputs.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Bp05_bkpt
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_backpatching_exp_gpu_h100_moments_goal_both_POS_sigma0p05_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_backpatching_exp_gpu_h100_moments_goal_both_POS_sigma0p05_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=80G
#SBATCH --time=24:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

RESULT_DIR="data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p05_nap_ig=5/backpatching"
DATA_FILE="./data/moments_goal/both_data_sigma0p05.csv"
mkdir -p "${RESULT_DIR}"

echo "=== Qwen2 MOMENTS goal backpatching ==="
echo "=== Counterfactual mode: both; POS-aware sigma0p05 dataset ==="
echo "=== Dataset: ${DATA_FILE} ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
nvidia-smi || true

python script_backpatching_experiment.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode both \
  --moments_data_file "${DATA_FILE}" \
  --src_layer_range 6 19 \
  --dst_layer_range 0 13 \
  --output_dir "${RESULT_DIR}"

echo "Saved sigma0p05 backpatching result directory: ${RESULT_DIR}"
echo "End time: $(date)"
