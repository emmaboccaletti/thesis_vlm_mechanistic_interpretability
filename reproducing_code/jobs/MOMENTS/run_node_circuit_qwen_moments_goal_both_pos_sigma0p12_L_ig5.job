#!/bin/bash
# Text-only/L-view MOMENTS goal circuit discovery for the regenerated POS-aware
# sigma0p12 both dataset. Run this after generating the POS/sigma compatibility
# CSVs. It writes the L node scores required by intersection and cross-modal jobs.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Bpos_L_ig5
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_circuit_gpu_h100_Bmoments_goal_both_POS_sigma0p12_L_ig5_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_circuit_gpu_h100_Bmoments_goal_both_POS_sigma0p12_L_ig5_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=64G
#SBATCH --time=03:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1

source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

RESULT_ROOT="data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p12_nap_ig=5"

echo "=== Qwen2 MOMENTS goal circuit discovery / eval ==="
echo "=== Counterfactual mode: both ==="
echo "=== View: L/text-only via --language_only ==="
echo "=== Dataset: sigma0p12 regenerated POS-aware compatibility CSVs ==="
echo "=== Result root: ${RESULT_ROOT} ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
echo "Working dir: $(pwd)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

nvidia-smi || true

python script_node_circuit_discovery_and_eval.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode both \
  --language_only \
  --ap_ig_steps 5 \
  --output_dir "${RESULT_ROOT}"

echo "End time: $(date)"

