#!/bin/bash
# Larger-circuit cross-modal interchange sweep for completed MOMENTS runs.
# Array entries cover Qwen2 baseline, Qwen2 POS sigma variants, and Qwen3.
# Each entry evaluates L/VL circuit sizes 10/10, 20/30, 30/50, and 50/70%.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --array=0-7
#SBATCH --job-name=Qwen_cross_sweep
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_cross_moments_goal_size_sweep_%A_%a.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_cross_moments_goal_size_sweep_%A_%a.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=80G
#SBATCH --time=08:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1
set -eo pipefail
source activate vlm_qwen_reproducing_env
set -u

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

# The first three entries use the pre-7 September Qwen2 outputs. The remaining
# entries use the current MOMENTS directory and its sigma-specific CSVs.
VARIANTS=(
  "qwen2_baseline_both|qwen2-7b-vl-instruct|both|/home/eboccaletti/reproducing_code/vlm-circuits-analysis/data/moments_goal as of 7sep/both_data.csv|data/moments_goal/results/qwen2-7b-vl-instruct_both_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen2_baseline_language|qwen2-7b-vl-instruct|language_only|/home/eboccaletti/reproducing_code/vlm-circuits-analysis/data/moments_goal as of 7sep/language_only_data.csv|data/moments_goal/results/qwen2-7b-vl-instruct_language_only_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen2_baseline_vision|qwen2-7b-vl-instruct|vision_only|/home/eboccaletti/reproducing_code/vlm-circuits-analysis/data/moments_goal as of 7sep/vision_only_data.csv|data/moments_goal/results/qwen2-7b-vl-instruct_vision_only_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen2_pos_sigma0p05|qwen2-7b-vl-instruct|both|data/moments_goal/both_data_sigma0p05.csv|data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p05_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen2_pos_sigma0p1|qwen2-7b-vl-instruct|both|data/moments_goal/both_data_sigma0p1.csv|data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p1_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen2_pos_sigma0p12|qwen2-7b-vl-instruct|both|data/moments_goal/both_data_sigma0p12.csv|data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p12_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen2_pos_sigma0p5|qwen2-7b-vl-instruct|both|data/moments_goal/both_data_sigma0p5.csv|data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p5_nap_ig=5|vlm_qwen_reproducing_env"
  "qwen3_both|qwen3-8b-vl-instruct|both|data/moments_goal/both_data.csv|data/moments_goal/results/qwen3-8b-vl-instruct_both_nap_ig=5|vlm_qwen3_reproducing_env"
)

IFS='|' read -r LABEL MODEL_NAME CF_MODE DATA_FILE SCORES_DIR ENV_NAME <<< "${VARIANTS[${SLURM_ARRAY_TASK_ID}]}"
source activate "${ENV_NAME}"

SWEEP_ROOT="${SCORES_DIR}/cross_modality/circuit_size_sweep"
PAIRS=(
  "0.10 0.10 l010_vl010"
  "0.20 0.30 l020_vl030"
  "0.30 0.50 l030_vl050"
  "0.50 0.70 l050_vl070"
)

echo "=== Cross-modal circuit-size sweep: ${LABEL} ==="
echo "=== Model: ${MODEL_NAME} ==="
echo "=== Counterfactual mode: ${CF_MODE} ==="
echo "=== Dataset: ${DATA_FILE} ==="
echo "=== Scores: ${SCORES_DIR} ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
nvidia-smi || true

for pair in "${PAIRS[@]}"; do
  read -r L_PCT VL_PCT TAG <<< "${pair}"
  RESULT_FILE="${SWEEP_ROOT}/${TAG}/faithfulness_nodes_cross_interchanges_LD_${SLURM_JOB_ID}.pt"
  mkdir -p "$(dirname "${RESULT_FILE}")"

  echo "Running ${LABEL}: L=${L_PCT}, VL=${VL_PCT}"
  python script_node_cross_modality_analysis.py \
    --model_name "${MODEL_NAME}" \
    --model_path "$([[ "${MODEL_NAME}" == qwen3-* ]] && echo /home/eboccaletti/models/qwen3vl8b || echo /home/eboccaletti/models/qwen2vl7b)" \
    --task_name moments_goal \
    --moments_cf_mode "${CF_MODE}" \
    --moments_data_file "${DATA_FILE}" \
    --scores_dir "${SCORES_DIR}" \
    --output_file "${RESULT_FILE}" \
    --l_circuit_percentage "${L_PCT}" \
    --vl_circuit_percentage "${VL_PCT}"

  echo "Saved result: ${RESULT_FILE}"
done

echo "End time: $(date)"
