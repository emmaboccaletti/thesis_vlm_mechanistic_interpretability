#!/bin/bash
# Clean behavioral baseline for Qwen2 on MOMENTS goal/no-goal.
# This is a forced-choice yes/no evaluation, not circuit analysis.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_MOMENTS_behavior
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_moments_goal_behavior_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_moments_goal_behavior_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=64G
#SBATCH --time=00:10:00

module purge
module load 2025
module load Anaconda3/2025.06-1

source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

echo "=== Qwen2 MOMENTS goal clean behavioral evaluation ==="
echo "=== Primary metric: constrained yes/no accuracy ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
nvidia-smi || true

python evaluate_moments_behavior.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --csv data/moments_goal/vision_only_data.csv \
  --output_csv data/moments_goal/results/qwen2_behavioral_evaluation/behavior_clean.csv

# Optional stricter variant: add this flag to the command above if desired:
#   --check_counterfactual_alignment

echo "End time: $(date)"
