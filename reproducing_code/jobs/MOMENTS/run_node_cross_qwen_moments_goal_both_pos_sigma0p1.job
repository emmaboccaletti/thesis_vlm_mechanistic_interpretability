#!/bin/bash
# MOMENTS goal cross-modal interchange analysis for POS-aware sigma0p1.
# Requires completed sigma0p1 language-only and vision-language circuits.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Bp1_cross
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_cross_gpu_h100_Bmoments_goal_both_POS_sigma0p1_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_node_cross_gpu_h100_Bmoments_goal_both_POS_sigma0p1_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=80G
#SBATCH --time=03:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

RESULT_ROOT="data/moments_goal/results/qwen2-7b-vl-instruct_both_POS_sigma0p1_nap_ig=5"
DATA_FILE="./data/moments_goal/both_data_sigma0p1.csv"
RESULT_FILE="${RESULT_ROOT}/cross_modality/faithfulness_nodes_cross_interchanges_LD_${SLURM_JOB_ID}.pt"
mkdir -p "$(dirname "${RESULT_FILE}")"

echo "=== Qwen2 MOMENTS goal cross-modal interchange ==="
echo "=== Counterfactual mode: both; POS-aware sigma0p1 dataset ==="
echo "=== Dataset: ${DATA_FILE} ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
nvidia-smi || true

python script_node_cross_modality_analysis.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode both \
  --moments_data_file "${DATA_FILE}" \
  --scores_dir "${RESULT_ROOT}" \
  --output_file "${RESULT_FILE}" \
  --l_circuit_percentage 0.01 \
  --vl_circuit_percentage 0.03

echo "Saved sigma0p1 cross-modal result: ${RESULT_FILE}"
echo "End time: $(date)"
