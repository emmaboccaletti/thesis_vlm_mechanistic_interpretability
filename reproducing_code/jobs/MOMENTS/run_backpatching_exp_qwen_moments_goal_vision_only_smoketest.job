#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Vmoments_goal_backpatch_vision_only_smoke_BackpatchingExp_gpu_h100
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_backpatching_exp_gpu_h100_Vmoments_goal_vision_only_smoketest_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/MOMENTS/qwen_backpatching_exp_gpu_h100_Vmoments_goal_vision_only_smoketest_%j.err
#SBATCH --cpus-per-task=9
#SBATCH --mem=80G
#SBATCH --time=00:30:00

module purge
module load 2025
module load Anaconda3/2025.06-1

source activate vlm_qwen_reproducing_env

set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

echo "=== Qwen backpatching experiment: MOMENTS goal smoke test (vision_only) ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"
echo "Working dir: $(pwd)"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"

nvidia-smi || true

python script_backpatching_experiment.py \
  --model_name qwen2-7b-vl-instruct \
  --model_path /home/eboccaletti/models/qwen2vl7b \
  --task_name moments_goal \
  --moments_cf_mode vision_only \
  --src_layer_range 6 19 \
  --dst_layer_range 0 13

echo "End time: $(date)"
