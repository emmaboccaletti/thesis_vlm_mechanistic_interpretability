#!/bin/bash
# Regenerate the MOMENTS goal CSVs while reusing the prebuilt full-corpus Qwen
# vocab cache. This job should load the cached pos_buckets instead of rebuilding
# the vocabulary.
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_momcsv
#SBATCH --output=/home/eboccaletti/reproducing_code/job_outputs/create_moments_dataset_qwen_full_pos_%j.out
#SBATCH --error=/home/eboccaletti/reproducing_code/job_outputs/create_moments_dataset_qwen_full_pos_%j.err
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=02:00:00

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate vlm_qwen_reproducing_env
set -euo pipefail

cd /home/eboccaletti/reproducing_code/vlm-circuits-analysis

echo "=== Create MOMENTS goal dataset with cached full POS vocab ==="
echo "Host: $(hostname)"
echo "Start time: $(date)"

python /home/eboccaletti/thesis_project/data_generation/create_moments_dataset.py \
  --task goal \
  --moments_root /scratch-shared/eboccaletti/MOMENTS \
  --frames_root /scratch-shared/eboccaletti/MOMENTS_frames/frames \
  --output_dir /home/eboccaletti/reproducing_code/vlm-circuits-analysis/data \
  --language_perturbation_mode dataset_sample \
  --language_vocab_source full \
  --language_vocab_pos_mode coarse \
  --language_tokenizer_path /home/eboccaletti/models/qwen2vl7b \
  --language_vocab_path /home/eboccaletti/reproducing_code/vlm-circuits-analysis/data/moments_goal/qwen_same_token_length_vocab_full_pos.json \
  --noise_sigma 0.12 \
  --extra_noise_sigmas 0.05,0.10,0.15,0.20

echo "End time: $(date)"
