#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=CheckEnvironmentTransformers
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:05:00
#SBATCH --output=/home/eboccaletti/thesis_project/job_outputs/slurm_check_env_transformers_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

# Activate your environment
source activate vlm_gpu
# Check whether the GPU is available
srun python -uc "import torch; print('GPU available?', torch.cuda.is_available())"
srun python -uc "import torch, transformers; print(torch.__version__); print(torch.cuda.get_device_name(0))"